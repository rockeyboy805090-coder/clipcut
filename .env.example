# ClipCut — copy to .env and fill in. NEVER commit a real .env to GitHub.
# Phase 1 needs NO key. Gemini is Phase 2/3 only (clip rescoring).
GEMINI_API_KEY=<redacted>
CLIPCUT_HOST=127.0.0.1
CLIPCUT_PORT=8000
# Default language: English. Captions in English words.
# Options: en (English, default), hinglish (Roman Hinglish), hi (Hindi)
WHISPER_LANGUAGE=en
WHISPER_MODEL=base
# Google sign-in (Phase 1 placeholder — leave empty until the user
# creates OAuth credentials in Google Cloud Console):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Phase 8 — YouTube Shorts posting (same OAuth client as sign-in, but a
# SEPARATE redirect URI + the youtube.upload scope). The user must, in
# Google Cloud Console: (1) create an OAuth 2.0 client (Desktop or Web
# app), (2) enable YouTube Data API v3 in the SAME project, (3) add the
# redirect URI below to the client's Authorized redirect URIs, exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/auth/youtube/callback
# Phase 6 — server secret for encrypting saved API keys (Fernet key
# derivation). Set a long random value on Render; locally, if unset,
# a random secret is generated once into .clipcut_key_secret (0600,
# gitignored). Rotating it makes previously saved keys unreadable.
# CLIPCUT_KEY_SECRET=
# Storage quota per user (bytes). Default 100 MB, per teardown.
# CLIPCUT_STORAGE_QUOTA_BYTES=104857600
